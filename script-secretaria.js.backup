// ==========================================
// 1. CONEXÃO COM O BANCO DE DADOS
// ==========================================
const supabaseUrl = 'COLE_SUA_URL_DO_SUPABASE_AQUI';
const supabaseKey = 'COLE_SUA_CHAVE_ANON_AQUI';

// Inicializa o cliente corretamente (Isso resolve o erro supabase.from is not a function)
const supabaseClient = supabase.createClient(supabaseUrl, supabaseKey);


// ==========================================
// 2. INICIALIZAÇÃO DA TELA
// ==========================================
document.addEventListener("DOMContentLoaded", () => {
    carregarCertificados();
    carregarContratos();
});

// NAVEGAÇÃO DAS ABAS
window.openTab = function (abaNome) {
    document.querySelectorAll('.aba').forEach(aba => aba.style.display = 'none');
    const abaAlvo = document.getElementById(abaNome);
    if (abaAlvo) abaAlvo.style.display = 'block';
}


// ==========================================
// 3. MÓDULO DE CERTIFICADOS (INTEIRO)
// ==========================================
async function carregarCertificados() {
    const tbody = document.querySelector('#lista-certificados tbody') || document.getElementById('lista-certificados');
    if (!tbody) return;

    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Carregando certificados...</td></tr>';

    try {
        // Usando o supabaseClient que criamos lá em cima!
        const { data: matriculas, error } = await supabaseClient
            .from('matriculas')
            .select(`
                id,
                status_conclusao,
                certificado_url,
                media_final,
                alunos (nome, ra),
                cursos (nome),
                turmas (nome)
            `);

        if (error) throw error;
        tbody.innerHTML = '';

        if (!matriculas || matriculas.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Nenhuma matrícula encontrada.</td></tr>';
            return;
        }

        matriculas.forEach(m => {
            const tr = document.createElement('tr');
            const aprovado = m.status_conclusao === 'Aprovado';

            let uploadHtml = '';
            if (m.certificado_url) {
                uploadHtml = `<span class="badge badge-azul">Certificado Enviado</span>`;
            } else if (aprovado) {
                uploadHtml = `
                    <div class="cert-upload-area" style="display:flex; gap:10px; align-items:center;">
                        <input type="file" accept=".pdf" id="cert-upload-${m.id}" style="font-size: 0.8em;">
                        <button type="button" class="btn-action" onclick="enviarCertificado('${m.id}')">Enviar</button>
                    </div>
                `;
            } else {
                uploadHtml = `<span style="color: #64748b; font-size: 0.9em;">Aguardando Validação</span>`;
            }

            tr.innerHTML = `
                <td>
                    <strong>${m.alunos?.nome || 'Aluno'}</strong><br>
                    <span style="font-size: 0.8em; color: gray;">RA: ${m.alunos?.ra || 'N/A'}</span>
                </td>
                <td>${m.cursos?.nome || 'Curso'}</td>
                <td>${m.turmas?.nome || 'Turma'}</td>
                <td>${m.media_final || '—'}</td>
                <td><span class="badge ${aprovado ? 'badge-verde' : 'badge-cinza'}">${m.status_conclusao || 'Pendente'}</span></td>
                <td>${uploadHtml}</td>
            `;
            tbody.appendChild(tr);
        });

    } catch (e) {
        console.error('Erro ao carregar certificados:', e);
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color: red;">Erro de conexão com o banco.</td></tr>';
    }
}

// Upload de PDF
window.enviarCertificado = async function (matriculaId) {
    const input = document.getElementById(`cert-upload-${matriculaId}`);
    if (!input || !input.files || input.files.length === 0) {
        alert("Selecione um arquivo PDF válido.");
        return;
    }

    const file = input.files[0];
    const filePath = `certificados/${matriculaId}_${file.name}`;

    try {
        const { error: uploadError } = await supabaseClient.storage
            .from('certificados')
            .upload(filePath, file, { upsert: true });

        if (uploadError) throw uploadError;

        const { data: publicUrlData } = supabaseClient.storage
            .from('certificados')
            .getPublicUrl(filePath);

        const { error: updateError } = await supabaseClient
            .from('matriculas')
            .update({ certificado_url: publicUrlData.publicUrl })
            .eq('id', matriculaId);

        if (updateError) throw updateError;

        alert("Certificado enviado com sucesso!");
        carregarCertificados();

    } catch (error) {
        console.error("Erro no upload:", error);
    }
};


// ==========================================
// 4. MÓDULO DE CONTRATOS (INTEIRO RECONSTRUÍDO)
// ==========================================
async function carregarContratos() {
    const tbody = document.querySelector('#lista-contratos tbody') || document.getElementById('lista-contratos');
    if (!tbody) return;

    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;">Carregando contratos...</td></tr>';

    try {
        const { data: matriculas, error } = await supabaseClient
            .from('matriculas')
            .select(`
                id,
                contrato_url,
                alunos (nome, ra),
                cursos (nome)
            `);

        if (error) throw error;
        tbody.innerHTML = '';

        if (!matriculas || matriculas.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;">Nenhum contrato encontrado.</td></tr>';
            return;
        }

        matriculas.forEach(m => {
            const tr = document.createElement('tr');

            // Se tiver contrato, mostra o botão de ver. Se não, mostra pendente.
            const statusContrato = m.contrato_url
                ? `<button class="btn-action" onclick="abrirContrato('${m.contrato_url}')">Ver Contrato</button>`
                : `<span style="color: #64748b;">Pendente</span>`;

            tr.innerHTML = `
                <td><strong>${m.alunos?.nome || 'Aluno'}</strong><br><span style="font-size: 0.8em; color: gray;">RA: ${m.alunos?.ra || 'N/A'}</span></td>
                <td>${m.cursos?.nome || 'Curso'}</td>
                <td><span class="badge ${m.contrato_url ? 'badge-verde' : 'badge-cinza'}">${m.contrato_url ? 'Assinado' : 'Aguardando'}</span></td>
                <td>${statusContrato}</td>
            `;
            tbody.appendChild(tr);
        });

    } catch (e) {
        console.error('Erro ao carregar contratos:', e);
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color: red;">Erro ao carregar dados.</td></tr>';
    }
}

// Abertura segura do Blob PDF
window.abrirContrato = function (base64Data) {
    try {
        const byteCharacters = atob(base64Data.split(',')[1] || base64Data);
        const byteNumbers = new Array(byteCharacters.length);
        for (let i = 0; i < byteCharacters.length; i++) {
            byteNumbers[i] = byteCharacters.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: 'application/pdf' });
        const blobUrl = URL.createObjectURL(blob);
        window.open(blobUrl, '_blank');
    } catch (e) {
        // Fallback caso a URL salva não seja Base64, e sim um link real do Storage
        if (base64Data.startsWith('http')) {
            window.open(base64Data, '_blank');
        } else {
            console.error("Erro ao gerar PDF", e);
            alert("Não foi possível abrir o contrato.");
        }
    }
}
